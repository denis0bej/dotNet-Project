@using System.Security.Claims
@model dotNet_Project.Models.Category

@{
    ViewData["Title"] = "Category: " + Model.Name;
    bool isOwner = (bool)ViewData["IsOwner"];
    bool isAdmin = (bool)ViewData["IsAdmin"];

    // Preluăm ID-ul userului curent pentru a verifica like-urile
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6">Category: <strong>@Model.Name</strong></h1>
            <p class="text-muted">
                Created by: <a asp-controller="Categories" asp-action="Profile" asp-route-userId="@Model.UserId">@Model.User?.UserName</a>

                @if (Model.IsPublic)
                {
                    <span class="badge bg-success ms-2">Public Folder</span>
                }
                else
                {
                    <span class="badge bg-secondary ms-2">Private Folder</span>
                }
            </p>
        </div>

        @if (isOwner)
        {
            <a asp-controller="Bookmarks" asp-action="New" class="btn btn-primary">
                + Add Bookmark Here
            </a>
        }
    </div>

    <hr />

    @if (!Model.Bookmarks.Any())
    {
        <div class="alert alert-warning">
            This category is empty.
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var bookmark in Model.Bookmarks)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        @if (!string.IsNullOrEmpty(bookmark.MediaUrl))
                        {
                            <img src="@bookmark.MediaUrl" class="card-img-top card-img-custom" alt="Bookmark Image">
                        }
                        else
                        {
                            <div class="card-img-top bg-light card-img-placeholder">
                                <span class="fs-1 text-muted"><i class="bi bi-bookmark-star"></i></span>
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title w-75">
                                    <a asp-controller="Bookmarks" asp-action="Details" asp-route-id="@bookmark.Id" class="text-decoration-none text-dark fw-bold">
                                        @bookmark.Title
                                    </a>
                                </h5>

                                @{
                                    // Calculăm starea like-ului pentru fiecare bookmark
                                    var isLikedByMe = bookmark.Votes.Any(v => v.UserId == currentUserId);
                                    var heartClass = isLikedByMe ? "bi-heart-fill text-danger" : "bi-heart";
                                }

                                @if (currentUserId != null)
                                {
                                    <div class="d-flex align-items-center cursor-pointer like-container" onclick="toggleLike(@bookmark.Id)">
                                        <i id="heart-icon-@bookmark.Id" class="bi @heartClass fs-5 me-1 like-icon"></i>
                                        <span id="like-count-@bookmark.Id" class="fw-bold small">@bookmark.LikeCount</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-heart fs-5 me-1"></i>
                                        <span class="fw-bold small">@bookmark.LikeCount</span>
                                    </div>
                                }
                            </div>

                            <p class="card-text text-muted small">
                                @if (bookmark.Description?.Length > 100)
                                {
                                    @bookmark.Description.Substring(0, 100) <text>...</text>
                                }
                                else
                                {
                                    @bookmark.Description
                                }
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <small class="text-muted">@bookmark.CreatedAt.ToString("dd MMM yyyy")</small>

                                @if (!bookmark.IsPublic)
                                {
                                    <span class="badge bg-secondary">Private Item</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-outline-secondary">Back to Categories</a>
    </div>
</div>