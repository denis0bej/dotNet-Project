@using System.Security.Claims
@model dotNet_Project.Models.Category

@{
    ViewData["Title"] = "Category: " + Model.Name;
    bool isOwner = (bool)ViewData["IsOwner"] as bool? ?? false;
    bool isAdmin = (bool)ViewData["IsAdmin"] as bool? ?? false;

    // Preluăm ID-ul userului curent pentru a verifica like-urile
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="display-6">Category: <strong>@Model.Name</strong></h1>
            <p class="text-muted">
                Created by:
                <a asp-controller="Profiles" asp-action="Show" asp-route-id="@Model.UserId" class="fw-bold text-decoration-none">
                    @Model.User?.UserName
                </a>

                @if (Model.IsPublic)
                {
                    <span class="badge bg-success ms-2">Public Folder</span>
                }
                else
                {
                    <span class="badge bg-secondary ms-2">Private Folder</span>
                }
            </p>
        </div>

        @if (isOwner)
        {
            <a asp-controller="Bookmarks" asp-action="New" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Bookmark
            </a>
        }
    </div>

    <hr />

    @if (!Model.Bookmarks.Any())
    {
        <div class="alert alert-warning text-center p-4">
            <h4><i class="bi bi-folder2-open"></i></h4>
            <p class="mb-0">This category is empty.</p>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var bookmark in Model.Bookmarks)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm transition-hover">

                        <div class="bg-light text-center overflow-hidden position-relative" style="height: 200px;">
                            @if (!string.IsNullOrEmpty(bookmark.MediaUrl) &&
                                                (bookmark.MediaUrl.EndsWith(".jpg") || bookmark.MediaUrl.EndsWith(".png") || bookmark.MediaUrl.EndsWith(".jpeg") || bookmark.MediaUrl.EndsWith(".webp")))
                            {
                                <img src="@bookmark.MediaUrl" class="w-100 h-100" style="object-fit: cover;" alt="@bookmark.Title">
                            }
                            else if (!string.IsNullOrEmpty(bookmark.MediaUrl) && (bookmark.MediaUrl.Contains("youtube.com") || bookmark.MediaUrl.Contains("youtu.be")))
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-danger">
                                    <i class="bi bi-youtube" style="font-size: 4rem;"></i>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                    <i class="bi bi-link-45deg" style="font-size: 4rem;"></i>
                                </div>
                            }
                        </div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title w-75">
                                    <a asp-controller="Bookmarks" asp-action="Show" asp-route-id="@bookmark.Id" class="text-decoration-none text-dark fw-bold">
                                        @bookmark.Title
                                    </a>
                                </h5>

                                @{
                                    // Calculăm starea like-ului pentru fiecare bookmark
                                    var isLikedByMe = bookmark.Votes.Any(v => v.UserId == currentUserId);
                                    var heartClass = isLikedByMe ? "bi-heart-fill text-danger" : "bi-heart";
                                }

                                @if (currentUserId != null)
                                {
                                    <div class="d-flex align-items-center cursor-pointer like-container" onclick="toggleLike(@bookmark.Id)">
                                        <i id="heart-icon-@bookmark.Id" class="bi @heartClass fs-5 me-1 like-icon"></i>
                                        <span id="like-count-@bookmark.Id" class="fw-bold small">@bookmark.LikeCount</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-heart fs-5 me-1"></i>
                                        <span class="fw-bold small">@bookmark.LikeCount</span>
                                    </div>
                                }
                            </div>

                            <p class="card-text text-muted small">
                                @if (bookmark.Description?.Length > 100)
                                {
                                    @bookmark.Description.Substring(0, 80)
                        
                                    <text>...</text>
                                }
                                else
                                {
                                    @bookmark.Description
                                }
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 border-top pt-2">
                                <small class="text-muted">
                                    <i class="bi bi-calendar3"></i> @bookmark.CreatedAt.ToString("dd MMM")
                                </small>

                                <div>
                                    <small class="text-muted me-2"><i class="bi bi-heart-fill text-danger"></i> @bookmark.LikeCount</small>

                                    @if (!bookmark.IsPublic)
                                    {
                                        <i class="bi bi-lock-fill text-secondary" title="Private"></i>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="mt-4">
        @if (isOwner)
        {
            <a asp-controller="Profiles" asp-action="Show" class="btn btn-outline-secondary">
                &larr; Back to My Profile
            </a>
        }
        else
        {
            <a asp-controller="Profiles" asp-action="Show" asp-route-id="@Model.UserId" class="btn btn-outline-secondary">
                &larr; Back to @(Model.User?.UserName)'s Profile
            </a>
        }
    </div>
</div>