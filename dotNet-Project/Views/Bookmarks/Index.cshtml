@using System.Security.Claims
@model IEnumerable<dotNet_Project.Models.Bookmark>

@{
    ViewData["Title"] = "Bookmark-urile Mele";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Bookmark-urile Mele</h1>
        <a asp-action="New" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Adaugă Nou
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Nu ai adăugat niciun bookmark încă. Începe acum!
        </div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            // Verificăm dacă userul curent a dat deja like
            var isLikedByMe = item.Votes.Any(v => v.UserId == currentUserId);
            var heartClass = isLikedByMe ? "bi-heart-fill text-danger" : "bi-heart";

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                    {
                        <img src="@item.MediaUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 200px;">
                            <span class="fs-1"><i class="bi bi-bookmark"></i></span>
                        </div>
                    }

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <h5 class="card-title text-truncate" style="max-width: 80%;">@item.Title</h5>
                            
                            <div class="d-flex align-items-center pointer" style="cursor: pointer;" onclick="toggleLike(@item.Id)">
                                <i id="heart-icon-@item.Id" class="bi @heartClass fs-4 me-1"></i>
                                <span id="like-count-@item.Id" class="fw-bold">@item.LikeCount</span>
                            </div>
                        </div>

                        <h6 class="card-subtitle mb-2 text-muted">
                            <i class="bi bi-folder"></i> Categ ID: @item.CategoryId
                        </h6>
                        <p class="card-text text-truncate">
                            @item.Description
                        </p>
                        <small class="text-muted">Adăugat: @item.CreatedAt.ToString("dd/MM/yyyy")</small>

                        <div class="mt-2">
                            @if (item.Tags != null)
                            {
                                foreach (var tag in item.Tags)
                                {
                                    <span class="badge bg-secondary me-1">
                                        <i class="bi bi-hash"></i>@tag.Name
                                    </span>
                                }
                            }
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Vezi detalii</a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">Edit <i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete <i class="bi bi-trash"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        async function toggleLike(bookmarkId) {
            try {
                // Selectăm elementele
                const heartIcon = document.getElementById(`heart-icon-${bookmarkId}`);
                const countSpan = document.getElementById(`like-count-${bookmarkId}`);

                const response = await fetch('/Bookmarks/ToggleLike', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.getElementsByName('__RequestVerificationToken')[0]?.value
                    },
                    body: JSON.stringify(bookmarkId)
                });

                if (response.ok) {
                    const data = await response.json();
                    
                    // Actualizăm numărul
                    countSpan.innerText = data.newCount;

                    // Logica pentru iconiță
                    if (data.isLiked) {
                        // S-a dat LIKE
                        heartIcon.classList.remove('bi-heart');
                        heartIcon.classList.add('bi-heart-fill', 'text-danger');

                        // --- AICI ESTE ANIMAȚIA ---
                        heartIcon.classList.add('animate-like');
                        
                        // Scoatem clasa de animație după 400ms (cât durează în CSS)
                        // ca să poată fi animat din nou data viitoare
                        setTimeout(() => {
                            heartIcon.classList.remove('animate-like');
                        }, 400);

                    } else {
                        // S-a dat UNLIKE
                        heartIcon.classList.add('bi-heart');
                        heartIcon.classList.remove('bi-heart-fill', 'text-danger');
                    }
                } else {
                    console.error("Eroare la server");
                }
            } catch (error) {
                console.error("Eroare de rețea:", error);
            }
        }
    </script>
}