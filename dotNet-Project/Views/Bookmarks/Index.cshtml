@using System.Security.Claims
@model IEnumerable<dotNet_Project.Models.Bookmark>

@{
    ViewData["Title"] = "My Bookmarks";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Personal Collection</h1>

        <a asp-action="New" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> New Bookmark
        </a>
    </div>

    <div class="row mb-4 justify-content-center">
        <div class="col-md-6">
            <form asp-controller="Bookmarks" asp-action="Index" method="get">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="searchString"
                           class="form-control border-start-0 border-end-0"
                           placeholder="Caută în colecția ta (ex: copac, privat)..."
                           value="@ViewData["CurrentFilter"]">

                    @if (ViewData["CurrentFilter"] != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary border-start-0 border-end-0" title="Șterge filtrele">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }

                    <button type="submit" class="btn btn-primary">Caută</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        @if (ViewData["CurrentFilter"] != null)
        {
            <div class="text-center py-5">
                <i class="bi bi-search display-4 text-muted mb-3 d-block"></i>
                <h4 class="text-danger">Nu am găsit nimic pentru "@ViewData["CurrentFilter"]"</h4>
                <p class="text-muted">Verifică dacă ai scris corect sau dacă postarea există în colecția ta.</p>
                <a asp-action="Index" class="btn btn-outline-secondary mt-2">Vezi toate bookmark-urile mele</a>
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-light rounded border border-dashed">
                <i class="bi bi-bookmark-plus display-4 text-secondary mb-3"></i>
                <h4>Încă nu ai niciun bookmark!</h4>
                <p class="text-muted">Începe prin a salva ideile tale preferate.</p>
                <a asp-action="New" class="btn btn-primary mt-2">Creează primul Bookmark</a>
            </div>
        }
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                // --- FIX: Definim variabilele aici, la inceputul buclei ---
                bool isOwner = (item.UserId == currentUserId);

                // Verificam si daca item.Votes nu e null inainte de Any()
                var isLikedByMe = item.Votes != null && item.Votes.Any(v => v.UserId == currentUserId);
                var heartClass = isLikedByMe ? "bi-heart-fill text-danger" : "bi-heart";
                // -----------------------------------------------------------

                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">

                        <div style="position: relative;">
                            @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                            {
                                <img src="@item.MediaUrl" class="card-img-top card-img-custom" alt="@item.Title">
                            }
                            else if (item.MediaUrl != null && item.MediaUrl.Contains("youtube"))
                            {
                                <div class="card-img-top bg-black card-img-placeholder">
                                    <i class="bi bi-youtube text-danger fs-1"></i>
                                </div>
                            }
                            else
                            {
                                <div class="card-img-top bg-light card-img-placeholder">
                                    <span class="fs-1 text-muted"><i class="bi bi-bookmark-star"></i></span>
                                </div>
                            }

                            <div class="card-overlay-badges">
                                @if (item.Categories != null)
                                {
                                    @foreach (var cat in item.Categories)
                                    {
                                        <span class="badge bg-light text-dark shadow-sm me-1">@cat.Name</span>
                                    }
                                }
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-truncate w-75">
                                    <a asp-action="Show" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                        @item.Title
                                    </a>
                                </h5>

                                @if (!item.IsPublic)
                                {
                                    <span class="text-danger" title="Privat"><i class="bi bi-lock-fill"></i></span>
                                }
                                else
                                {
                                    <span class="text-success" title="Public"><i class="bi bi-globe"></i></span>
                                }
                            </div>

                            @{
                                var isLikedByMe = item.Votes.Any(v => v.UserId == currentUserId);
                                var heartClass = isLikedByMe ? "bi-heart-fill text-danger" : "bi-heart";
                            }
                            <div class="d-flex align-items-center mb-2 cursor-pointer like-container" onclick="toggleLike(@item.Id)">
                                <i id="heart-icon-@item.Id" class="bi @heartClass text-danger me-1 like-icon"></i>
                                <span id="like-count-@item.Id" class="text-muted small">@item.LikeCount</span>
                            </div>

                            <p class="card-text text-truncate text-muted small">
                                @item.Description
                            </p>
                        </div>

                        <div class="card-footer bg-white border-top-0">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Show" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                                <div>
                                    @if (isOwner)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    @if (isOwner || User.IsInRole("Admin"))
                                    {
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-action="SaveToCollection" asp-route-id="@item.Id" class="btn btn-sm btn-danger text-white" title="Save to my collection">
                                            <i class="bi bi-pin-angle-fill"></i> Save
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        async function toggleLike(bookmarkId) {
            try {
                const heartIcon = document.getElementById(`heart-icon-${bookmarkId}`);
                const countSpan = document.getElementById(`like-count-${bookmarkId}`);
                const token = document.getElementsByName('__RequestVerificationToken')[0]?.value;

                const response = await fetch('/Bookmarks/ToggleLike', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(bookmarkId)
                });

                if (response.ok) {
                    const data = await response.json();
                    countSpan.innerText = data.newCount;

                    if (data.isLiked) {
                        heartIcon.classList.remove('bi-heart');
                        heartIcon.classList.add('bi-heart-fill', 'text-danger');
                        heartIcon.classList.add('animate-like');
                        setTimeout(() => { heartIcon.classList.remove('animate-like'); }, 400);
                    } else {
                        heartIcon.classList.add('bi-heart');
                        heartIcon.classList.remove('bi-heart-fill', 'text-danger');
                    }
                }
            } catch (error) {
                console.error("Network error:", error);
            }
        }
    </script>
}