@using dotNet_Project.Models
@using System.Security.Claims
@model PaginatedList<dotNet_Project.Models.BookmarkCardViewModel>

@{
    ViewData["Title"] = "My Personal Collection";
}

@Html.AntiForgeryToken()

<div class="container mt-4 mb-5">
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-0">My Collection</h1>
            <p class="text-muted small">Manage all your bookmarks.</p>
        </div>

        <a asp-action="New" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add New
        </a>
    </div>

    <div class="row mb-3 justify-content-center">
        <div class="col-md-8">
            <form asp-controller="Bookmarks" asp-action="Index" method="get">
                <div class="input-group mb-3">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-muted"></i>
                    </span>
                    <input type="text"
                           name="searchString"
                           class="form-control border-start-0 border-end-0"
                           placeholder="Caută în colecția ta (ex: copac, privat)..."
                           value="@ViewData["CurrentFilter"]">

                    @if (ViewData["CurrentFilter"] != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary border-start-0 border-end-0" title="Șterge filtrele">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                    <button type="submit" class="btn btn-primary">Caută</button>
                </div>
                @if (ViewData["CurrentSort"] != null)
                {
                    <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
                }
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-center mb-5">
        <div class="btn-group shadow-sm" role="group">
            <a asp-action="Index"
               asp-route-sortOrder="Date"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-sm @(ViewData["CurrentSort"] == "Date" || ViewData["CurrentSort"] == null ? "btn-primary" : "btn-outline-primary")">
                <i class="bi bi-clock"></i> Cele mai Recente
            </a>

            <a asp-action="Index"
               asp-route-sortOrder="Popular"
               asp-route-searchString="@ViewData["CurrentFilter"]"
               class="btn btn-sm @(ViewData["CurrentSort"] == "Popular" ? "btn-danger" : "btn-outline-danger")">
                <i class="bi bi-fire"></i> Cele mai Populare
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="bi bi-folder2-open display-1 text-muted opacity-25"></i>
            </div>
            @if (ViewData["CurrentFilter"] != null)
            {
                <h4 class="text-danger">Nu am găsit nimic pentru "@ViewData["CurrentFilter"]"</h4>
                <a asp-action="Index" class="btn btn-outline-secondary mt-2">Vezi toate</a>
            }
            else
            {
                <h4 class="text-muted">You don't have any bookmarks yet.</h4>
                <p class="mb-4">Start by adding your first idea!</p>
                <a asp-action="New" class="btn btn-outline-primary">Create Bookmark</a>
            }
        </div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            var heartClass = item.IsLikedByCurrentUser ? "bi-heart-fill text-danger" : "bi-heart";
            
            // Verificare permisiuni (Admin sau Proprietar)
            // Notă: Folosim User.Identity.Name deoarece ViewModel-ul conține UserName
            var isOwner = User.Identity.IsAuthenticated && item.UserName == User.Identity.Name;
            var isAdmin = User.IsInRole("Admin");

            <div class="col-md-4 mb-4">
                <div class="card post-card h-100">

                    <a asp-action="Show" asp-route-id="@item.Id" class="card-main-link" aria-label="@item.Title"></a>

                    @if (isOwner || isAdmin)
                    {
                        <div class="position-absolute top-0 start-0 p-3 bring-to-front d-flex gap-2" style="z-index: 10;">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm rounded-circle shadow-sm" title="Edit" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-pencil-fill text-dark small"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm rounded-circle shadow-sm" title="Delete" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-trash-fill text-danger small"></i>
                            </a>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                    {
                        <img src="@item.MediaUrl" class="post-img-bg card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    }
                    else if (item.MediaUrl != null && item.MediaUrl.Contains("youtube"))
                    {
                        <div class="post-placeholder-bg bg-black card-img-top" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-youtube text-danger fs-1"></i>
                        </div>
                    }
                    else
                    {
                        <div class="post-placeholder-bg bg-light card-img-top" style="height: 200px; display: flex; align-items: center; justify-content: center;">
                            <span class="fs-1 text-muted"><i class="bi bi-bookmark-star"></i></span>
                        </div>
                    }

                    <div class="post-badges-top bring-to-front position-absolute top-0 end-0 p-3">
                        @foreach (var catName in item.CategoryNames)
                        {
                            <span class="badge bg-light text-dark shadow-sm opacity-90 me-1">
                                @catName
                            </span>
                        }
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="card-title fw-bold text-truncate w-75 mb-0">
                                @item.Title
                            </h5>
                            
                            @if (item.IsPublic)
                            {
                                <span class="text-success" title="Public"><i class="bi bi-globe"></i></span>
                            }
                            else
                            {
                                <span class="text-danger" title="Private"><i class="bi bi-lock-fill"></i></span>
                            }
                        </div>

                        <div class="d-flex align-items-center cursor-pointer like-container bring-to-front" onclick="toggleLike(@item.Id)">
                            <i id="heart-icon-@item.Id" class="bi @heartClass fs-5 me-1 like-icon text-danger"></i>
                            <span id="like-count-@item.Id" class="fw-bold small text-muted">@item.LikeCount</span>
                        </div>
                        
                        <p class="card-text text-truncate text-muted small mt-2">
                            @item.Description
                        </p>
                    </div>

                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-4 mb-5">
        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }

        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-outline-secondary me-2 @prevDisabled">
            <i class="bi bi-arrow-left"></i> Previous
        </a>

        <span class="align-self-center mx-3 fw-bold text-muted">
            Page @Model.PageIndex of @Model.TotalPages
        </span>

        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-outline-secondary @nextDisabled">
            Next <i class="bi bi-arrow-right"></i>
        </a>
    </div>

</div>

@section Scripts {
    <script>
        async function toggleLike(bookmarkId) {
             try {
                 const heartIcon = document.getElementById(`heart-icon-${bookmarkId}`);
                 const countSpan = document.getElementById(`like-count-${bookmarkId}`);
                 const token = document.getElementsByName('__RequestVerificationToken')[0]?.value;

                 const response = await fetch('/Bookmarks/ToggleLike', {
                     method: 'POST',
                     headers: {
                         'Content-Type': 'application/json',
                         'RequestVerificationToken': token
                     },
                     body: JSON.stringify(bookmarkId)
                 });

                 if (response.ok) {
                     const data = await response.json();
                     countSpan.innerText = data.newCount;

                     if (data.isLiked) {
                         heartIcon.classList.remove('bi-heart');
                         heartIcon.classList.add('bi-heart-fill', 'text-danger');
                         heartIcon.classList.add('animate-like');
                         setTimeout(() => { heartIcon.classList.remove('animate-like'); }, 400);
                     } else {
                         heartIcon.classList.add('bi-heart');
                         heartIcon.classList.remove('bi-heart-fill', 'text-danger');
                     }
                 }
             } catch (error) {
                 console.error("Network error:", error);
             }
         }
    </script>
}