@using System.Security.Claims
@model IEnumerable<dotNet_Project.Models.Bookmark>

@{
    ViewData["Title"] = "My Bookmarks";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Collection & Public Bookmarks</h1>
        <a asp-action="New" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> New Bookmark
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            You haven't saved any bookmarks yet.
            <a asp-action="New">Create one now!</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">

                        <div style="position: relative;">
                            @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                            {
                                <img src="@item.MediaUrl" class="card-img-top card-img-custom" alt="@item.Title">
                            }
                            else if (item.MediaUrl != null && item.MediaUrl.Contains("youtube"))
                            {
                                <div class="card-img-top bg-black card-img-placeholder">
                                    <i class="bi bi-youtube text-danger fs-1"></i>
                                </div>
                            }
                            else
                            {
                                <div class="card-img-top bg-light card-img-placeholder">
                                    <span class="fs-1 text-muted"><i class="bi bi-bookmark-star"></i></span>
                                </div>
                            }

                            <div class="card-overlay-badges">
                                @if (item.Categories != null)
                                {
                                    @foreach (var cat in item.Categories)
                                    {
                                        <span class="badge bg-light text-dark shadow-sm me-1">
                                            @cat.Name
                                        </span>
                                    }
                                }
                            </div>
                        </div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-truncate w-75">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                        @item.Title
                                    </a>
                                </h5>

                                @{
                                    var isLikedByMe = item.Votes.Any(v => v.UserId == currentUserId);
                                    var heartClass = isLikedByMe ? "bi-heart-fill text-danger" : "bi-heart";
                                }

                                @if (currentUserId != null)
                                {
                                    <div class="d-flex align-items-center cursor-pointer like-container" onclick="toggleLike(@item.Id)">
                                        <i id="heart-icon-@item.Id" class="bi @heartClass fs-4 me-1 like-icon"></i>
                                        <span id="like-count-@item.Id" class="fw-bold">@item.LikeCount</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center text-muted">
                                        <i class="bi bi-heart fs-4 me-1"></i>
                                        <span class="fw-bold">@item.LikeCount</span>
                                    </div>
                                }
                            </div>

                            <p class="card-subtitle text-muted mb-2 small">
                                <i class="bi bi-person-circle"></i> @(item.User?.UserName ?? "Unknown")
                            </p>

                            <p class="card-text text-truncate text-muted">
                                @if (!string.IsNullOrEmpty(item.Description) && item.Description.Length > 80)
                                {
                                    @item.Description.Substring(0, 80) <text>...</text>
                                }
                                else
                                {
                                    @item.Description
                                }
                            </p>
                        </div>

                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill">Details</a>

                            @if (item.UserId == currentUserId || User.IsInRole("Admin"))
                            {
                                <div>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm rounded-circle"><i class="bi bi-pencil"></i></a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm rounded-circle"><i class="bi bi-trash"></i></a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>