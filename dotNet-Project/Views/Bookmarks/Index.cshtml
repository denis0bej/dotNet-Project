@using System.Security.Claims
@model IEnumerable<dotNet_Project.Models.BookmarkCardViewModel>

@{
    ViewData["Title"] = "My Personal Collection";
}

@Html.AntiForgeryToken()

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-0">Your Bookmarks</h1>
            <p class="text-muted small">These are ALL your bookmarks!</p>
        </div>

        <a asp-action="New" class="btn btn-primary rounded-pill px-4 shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Add Bookmark
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="mb-3">
                <i class="bi bi-folder2-open display-1 text-muted opacity-25"></i>
            </div>
            <h4 class="text-muted">Much empty.. </h4>
            <p class="mb-4">Add a new <b>Bookmark</b> to fill this void!</p>
            <a asp-action="New" class="btn btn-outline-primary">Add Bookmark</a>
        </div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            var heartClass = item.IsLikedByCurrentUser ? "bi-heart-fill text-danger" : "bi-heart";

            <div class="col-md-4 mb-4">
                <div class="card post-card">

                    <a asp-action="Show" asp-route-id="@item.Id" class="card-main-link" aria-label="@item.Title"></a>

                    <div class="position-absolute top-0 start-0 p-3 bring-to-front d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm rounded-circle shadow-sm" title="Editează" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-pencil-fill text-dark small"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm rounded-circle shadow-sm" title="Șterge" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                            <i class="bi bi-trash-fill text-danger small"></i>
                        </a>
                    </div>

                    @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                    {
                        <img src="@item.MediaUrl" class="post-img-bg" alt="@item.Title">
                    }
                    else if (item.MediaUrl != null && item.MediaUrl.Contains("youtube"))
                    {
                        <div class="post-placeholder-bg bg-black">
                            <i class="bi bi-youtube text-danger fs-1"></i>
                        </div>
                    }
                    else
                    {
                        <div class="post-placeholder-bg">
                            <span class="fs-1 text-muted"><i class="bi bi-bookmark-star"></i></span>
                        </div>
                    }

                    <div class="post-badges-top bring-to-front">
                        @foreach (var catName in item.CategoryNames)
                        {
                            <span class="badge bg-light text-dark shadow-sm opacity-75">
                                @catName
                            </span>
                        }
                    </div>

                    <div class="post-content-overlay">
                        <div class="d-flex justify-content-between align-items-center">

                            <div class="d-flex flex-column pe-3" style="min-width: 0;">
                                <h5 class="card-title fw-bold text-truncate w-100 mb-1">
                                    @item.Title
                                </h5>

                                <div class="d-flex align-items-center bring-to-front position-relative">
                                    @if (!string.IsNullOrEmpty(item.UserProfilePicture))
                                    {
                                        <img src="@item.UserProfilePicture" class="user-avatar-small" alt="User">
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle me-1 text-muted fs-5"></i>
                                    }
                                    <span class="card-subtitle text-muted small mb-0 fw-semibold text-truncate">
                                        @item.UserDisplayName
                                    </span>
                                </div>
                            </div>

                            <div class="d-flex align-items-center cursor-pointer like-container bring-to-front flex-shrink-0" onclick="toggleLike(@item.Id)">
                                <i id="heart-icon-@item.Id" class="bi @heartClass fs-3 me-1 like-icon"></i>
                                <span id="like-count-@item.Id" class="fw-bold">@item.LikeCount</span>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        async function toggleLike(bookmarkId) {
             try {
                 const heartIcon = document.getElementById(`heart-icon-${bookmarkId}`);
                 const countSpan = document.getElementById(`like-count-${bookmarkId}`);
                 // Token-ul este necesar pentru securitate (ValidateAntiForgeryToken)
                 const token = document.getElementsByName('__RequestVerificationToken')[0]?.value;

                 const response = await fetch('/Bookmarks/ToggleLike', {
                     method: 'POST',
                     headers: {
                         'Content-Type': 'application/json',
                         'RequestVerificationToken': token
                     },
                     body: JSON.stringify(bookmarkId)
                 });

                 if (response.ok) {
                     const data = await response.json();
                     countSpan.innerText = data.newCount;

                     if (data.isLiked) {
                         heartIcon.classList.remove('bi-heart');
                         heartIcon.classList.add('bi-heart-fill', 'text-danger');
                         heartIcon.classList.add('animate-like');
                         setTimeout(() => { heartIcon.classList.remove('animate-like'); }, 400);
                     } else {
                         heartIcon.classList.add('bi-heart');
                         heartIcon.classList.remove('bi-heart-fill', 'text-danger');
                     }
                 }
             } catch (error) {
                 console.error("Network error:", error);
             }
         }
    </script>
}