@using dotNet_Project.Models
@using System.Security.Claims
@model PaginatedList<BookmarkCardViewModel>

@{
    ViewData["Title"] = "My Personal Collection";
}

@Html.AntiForgeryToken()

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-5">
        <div>
            <h1 class="display-6 fw-bold mb-0 text-dark">My Collection</h1>
            <p class="text-muted small">Manage and organize your personal bookmarks.</p>
        </div>

        <a asp-action="New" class="btn btn-success rounded-pill px-4 shadow-sm d-flex align-items-center">
            <span class="fw-bold me-2">Add New Bookmark</span> <i class="bi bi-plus-lg"></i>
        </a>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <form asp-controller="Bookmarks" asp-action="Index" method="get">
                <div class="input-group shadow-sm">
                    <input type="text"
                           name="searchString"
                           class="form-control border-end-0 py-2 ps-4"
                           placeholder="Search your collection..."
                           value="@ViewData["CurrentFilter"]"
                           style="border-radius: 50px 0 0 50px; border-color: #ced4da;">

                    @if (ViewData["CurrentFilter"] != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary border-start-0 border-end-0 d-flex align-items-center" title="Clear Search" style="border-color: #ced4da;">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }

                    <button class="btn btn-primary px-4 d-flex align-items-center gap-2" type="submit" style="border-radius: 0 50px 50px 0;">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card post-card h-100 shadow-sm border-0">
                        <a asp-action="Show" asp-route-id="@item.Id" class="card-main-link"></a>

                        <div class="position-relative overflow-hidden" style="height: 200px;">
                            @if (!string.IsNullOrEmpty(item.MediaUrl))
                            {
                                <img src="@item.MediaUrl" class="w-100 h-100 object-fit-cover" alt="@item.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 bg-light d-flex justify-content-center align-items-center">
                                    <i class="bi bi-image text-muted fs-1"></i>
                                </div>
                            }

                            <div class="post-badges-top">
                                @foreach (var catName in item.CategoryNames.Take(2))
                                {
                                    <span class="badge bg-white text-dark shadow-sm opacity-90">@catName</span>
                                }
                            </div>

                            <div class="position-absolute bottom-0 start-0 m-2">
                                <span class="badge @(item.IsPublic ? "bg-success" : "bg-secondary") shadow-sm">
                                    @(item.IsPublic ? "Public" : "Private")
                                </span>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark text-truncate">@item.Title</h5>
                            <p class="card-text text-muted small text-truncate">
                                @(string.IsNullOrEmpty(item.Description) ? "No description provided." : item.Description)
                            </p>

                            <div class="mt-auto d-flex align-items-center justify-content-between pt-3 border-top">
                                <small class="text-muted">
                                    <i class="bi bi-calendar3 me-1"></i> @item.CreatedAt.ToString("dd MMM yyyy")
                                </small>

                                <div class="like-container bring-to-front d-flex align-items-center gap-1" onclick="toggleLike(@item.Id)" style="cursor: pointer; z-index: 5;">
                                    <i id="heart-icon-@item.Id"
                                       class="bi @(item.IsLikedByCurrentUser ? "bi-heart-fill text-danger" : "bi-heart text-dark") fs-5 like-icon"></i>
                                    <span id="like-count-@item.Id" class="fw-bold small text-dark">@item.LikeCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted opacity-75">
                    <i class="bi bi-journal-bookmark fs-1"></i>
                    <p class="mt-3 fs-5">You haven't added any bookmarks yet.</p>
                    <a asp-action="New" class="btn btn-outline-success mt-2">Create Your First Bookmark</a>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-5">
        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }

        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-outline-dark me-2 @prevDisabled rounded-pill px-4">
            <i class="bi bi-arrow-left"></i> Previous
        </a>

        <span class="align-self-center mx-3 fw-bold text-muted">
            Page @Model.PageIndex of @Model.TotalPages
        </span>

        <a asp-action="Index"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-outline-dark @nextDisabled rounded-pill px-4">
            Next <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>