@model IEnumerable<dotNet_Project.Models.Bookmark>

@{
    ViewData["Title"] = "Bookmarks";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>My Bookmarks</h1>
        <a asp-action="New" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add New
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            Look how much empty... Fill it with some bookmarks!
        </div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm">

                    @* --- SECTIUNE IMAGINE --- *@
                    @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                    {
                        <img src="@item.MediaUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                    }
                    else
                    {
                        <div class="card-img-top bg-secondary text-white d-flex justify-content-center align-items-center" style="height: 200px;">
                            <span class="fs-1"><i class="bi bi-bookmark"></i></span>
                        </div>
                    }

                    <div class="card-body">
                        @* --- TITLU + BADGE PRIVAT --- *@
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@item.Title</h5>

                            @if (!item.IsPublic)
                            {
                                <span class="badge bg-danger" title="Acest bookmark este privat">
                                    <i class="bi bi-lock-fill"></i> Privat
                                </span>
                            }
                        </div>

                        <h6 class="card-subtitle mb-2 text-muted">
                            <i class="bi bi-folder"></i> Category: @item.CategoryId
                        </h6>

                        <p class="card-text text-truncate">
                            @item.Description
                        </p>

                        <small class="text-muted">Date added: @item.CreatedAt.ToString("dd/MM/yyyy")</small>

                        <div class="mt-2">
                            @if (item.Tags != null)
                            {
                                foreach (var tag in item.Tags)
                                {
                                    <span class="badge bg-secondary me-1">
                                        <i class="bi bi-hash"></i>@tag.Name
                                    </span>
                                }
                            }
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                            View
                        </a>

                        <div>
                            @* Am decomentat butonul de Edit ca să poți modifica vizibilitatea *@
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                Edit <i class="bi bi-pencil"></i>
                            </a>

                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                Delete <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>