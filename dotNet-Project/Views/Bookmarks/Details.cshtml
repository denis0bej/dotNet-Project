@using System.Security.Claims
@model dotNet_Project.Models.Bookmark

@{
    ViewData["Title"] = "Bookmark Details";
    // --- LOGICA PENTRU LIKE ---
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    // Verificăm dacă lista de voturi există și dacă userul curent a votat
    var isLikedByMe = Model.Votes != null && Model.Votes.Any(v => v.UserId == currentUserId);
    var heartClass = isLikedByMe ? "bi-heart-fill text-danger" : "bi-heart";
}

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <h3 class="mb-0">@Model.Title</h3>

                @if (currentUserId != null)
                {
                    <div class="d-flex align-items-center cursor-pointer like-container bg-white text-primary px-3 py-1 rounded-pill shadow-sm" onclick="toggleLike(@Model.Id)">
                        <i id="heart-icon-@Model.Id" class="bi @heartClass fs-5 me-2 like-icon"></i>
                        <span id="like-count-@Model.Id" class="fw-bold">@Model.LikeCount</span>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center bg-white text-primary px-3 py-1 rounded-pill shadow-sm">
                        <i class="bi bi-heart fs-5 me-2"></i>
                        <span class="fw-bold">@Model.LikeCount</span>
                    </div>
                }
            </div>

            <div>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-controller="Categories" asp-action="Show" asp-route-id="@cat.Id" class="text-decoration-none">
                        <span class="badge bg-light text-primary me-1">@cat.Name</span>
                    </a>
                }
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    @if (!string.IsNullOrEmpty(Model.MediaUrl))
                    {
                        // Verificare YouTube
                        if (Model.MediaUrl.Contains("youtube.com") || Model.MediaUrl.Contains("youtu.be"))
                        {
                            var videoId = Model.MediaUrl.Split("v=").LastOrDefault();
                            if (Model.MediaUrl.Contains("youtu.be/"))
                            {
                                videoId = Model.MediaUrl.Split("youtu.be/").LastOrDefault()?.Split("?").FirstOrDefault();
                            }

                            <div class="ratio ratio-16x9">
                                <iframe src="https://www.youtube.com/embed/@videoId" allowfullscreen></iframe>
                            </div>
                        }
                        // Verificare Imagine
                        else if (Model.MediaUrl.EndsWith(".jpg") || Model.MediaUrl.EndsWith(".png") || Model.MediaUrl.EndsWith(".jpeg") || Model.MediaUrl.EndsWith(".webp"))
                        {
                            <img src="@Model.MediaUrl" class="img-fluid rounded img-details-fluid" alt="@Model.Title">
                        }
                        // Link extern
                        else
                        {
                            <div class="alert alert-secondary">
                                <i class="bi bi-link-45deg"></i> External link:
                                <a href="@Model.MediaUrl" target="_blank">@Model.MediaUrl</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center p-5 bg-light rounded">
                            <i class="bi bi-image text-muted icon-placeholder-large"></i>
                            <p>No media content</p>
                        </div>
                    }
                </div>

                <div class="col-md-6">
                    <h5>Description</h5>
                    <p class="lead text-pre-wrap" style="font-size: 1rem;">@Model.Description</p>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Date added</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("g")</dd>

                        @if (Model.User != null)
                        {
                            <dt class="col-sm-4">Author</dt>
                            <dd class="col-sm-8">
                                <a asp-controller="Categories" asp-action="Profile" asp-route-userId="@Model.UserId">
                                    @Model.User.UserName
                                </a>
                            </dd>
                        }
                    </dl>

                    @if (Model.Tags.Any())
                    {
                        <div class="mb-3">
                            <strong>Tags: </strong>
                            @foreach (var tag in Model.Tags)
                            {
                                <span class="badge bg-secondary">#@tag.Name</span>
                            }
                        </div>
                    }

                    <div class="mt-4 d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                        <a asp-action="Index" class="btn btn-secondary">Back to list</a>
                        <a asp-action="SaveToCollection" asp-route-id="@Model.Id" class="btn btn-outline-primary">Save to My Category</a>
                    </div>

                    <hr class="my-4" />

                    <div class="comments-section">
                        <h4>Comentarii (@Model.Comments.Count)</h4>

                        <div class="mt-3 mb-4">
                            @if (Model.Comments.Any())
                            {
                                @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAt))
                                {
                                    <div class="card mb-2 shadow-sm">
                                        <div class="card-body p-2">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <strong>@comment.User?.UserName</strong>
                                                    <span class="text-muted small ms-2">@comment.CreatedAt.ToString("g")</span>
                                                </div>

                                                <div>
                                                    @if (User.Identity.IsAuthenticated)
                                                    {
                                                        if (comment.User?.UserName == User.Identity.Name)
                                                        {
                                                            <a asp-controller="Comments" asp-action="Edit" asp-route-id="@comment.Id" class="btn btn-sm btn-link text-warning p-0 me-2">
                                                                <i class="bi bi-pencil"></i> Editează
                                                            </a>
                                                        }

                                                        if (comment.User?.UserName == User.Identity.Name || User.IsInRole("Admin"))
                                                        {
                                                            <form asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.Id" method="post" class="d-inline">
                                                                <button type="submit" class="btn btn-sm btn-link text-danger p-0" onclick="return confirm('Ești sigur?')">
                                                                    <i class="bi bi-trash"></i> Șterge
                                                                </button>
                                                            </form>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            <p class="mt-1 mb-0 text-pre-wrap">@comment.Content</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">Fii primul care lasă un comentariu!</p>
                            }
                        </div>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Comments" asp-action="Add" method="post">
                                <input type="hidden" name="BookmarkId" value="@Model.Id" />
                                <div class="form-group mb-2">
                                    <textarea name="Content" class="form-control" rows="3" placeholder="Scrie un comentariu..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="bi bi-send"></i> Postează Comentariul
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                <a href="/Identity/Account/Login">Autentifică-te</a> pentru a posta un comentariu.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>