@model dotNet_Project.Models.Bookmark

@{
    ViewData["Title"] = "Bookmark Details";
}

<div class="container mt-5">
    <div class="card shadow-lg">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">@Model.Title</h3>

            <div>
                @foreach (var cat in Model.Categories)
                {
                    <a asp-controller="Categories" asp-action="Show" asp-route-id="@cat.Id" class="text-decoration-none">
                        <span class="badge bg-light text-primary me-1">@cat.Name</span>
                    </a>
                }
            </div>
        </div>

        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    @if (!string.IsNullOrEmpty(Model.MediaUrl))
                    {
                        // Verificare simpla pentru YouTube Embed
                        if (Model.MediaUrl.Contains("youtube.com") || Model.MediaUrl.Contains("youtu.be"))
                        {
                            var videoId = Model.MediaUrl.Split("v=").LastOrDefault();
                            // Tratare cazuri simple de link youtu.be/ID
                            if (Model.MediaUrl.Contains("youtu.be/"))
                            {
                                videoId = Model.MediaUrl.Split("youtu.be/").LastOrDefault()?.Split("?").FirstOrDefault();
                            }

                            <div class="ratio ratio-16x9">
                                <iframe src="https://www.youtube.com/embed/@videoId" allowfullscreen></iframe>
                            </div>
                        }
                        // Verificare Imagine
                        else if (Model.MediaUrl.EndsWith(".jpg") || Model.MediaUrl.EndsWith(".png") || Model.MediaUrl.EndsWith(".jpeg") || Model.MediaUrl.EndsWith(".webp"))
                        {
                            <img src="@Model.MediaUrl" class="img-fluid rounded" alt="@Model.Title">
                        }
                        // Link simplu
                        else
                        {
                            <div class="alert alert-secondary">
                                <i class="bi bi-link-45deg"></i> External link:
                                <a href="@Model.MediaUrl" target="_blank">@Model.MediaUrl</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center p-5 bg-light rounded">
                            <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                            <p>No media content</p>
                        </div>
                    }
                </div>

                <div class="col-md-6">
                    <h5>Description</h5>
                    <p class="lead" style="font-size: 1rem; white-space: pre-wrap;">@Model.Description</p>

                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">Date added</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("g")</dd>

                        @if (Model.User != null)
                        {
                            <dt class="col-sm-4">Author</dt>
                            <dd class="col-sm-8">
                                <a asp-controller="Categories" asp-action="Profile" asp-route-userId="@Model.UserId">
                                    @Model.User.UserName
                                </a>
                            </dd>
                        }
                    </dl>

                    @if (Model.Tags.Any())
                    {
                        <div class="mb-3">
                            <strong>Tags: </strong>
                            @foreach (var tag in Model.Tags)
                            {
                                <span class="badge bg-secondary">#@tag.Name</span>
                            }
                        </div>
                    }

                    <div class="mt-4 d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                        <a asp-action="Index" class="btn btn-secondary">Back to list</a>

                        <a asp-action="SaveToCollection" asp-route-id="@Model.Id" class="btn btn-outline-primary">Save to My Category</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>