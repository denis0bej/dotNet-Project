@model dotNet_Project.Models.Bookmark

@{
    ViewData["Title"] = "Delete Bookmark";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-danger shadow">
                <div class="card-header bg-danger text-white">
                    <h4 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Delete Bookmark</h4>
                </div>
                <div class="card-body">
                    <h5 class="card-title text-center mb-4">Are you sure you want to delete this bookmark?</h5>

                    <div class="alert alert-warning text-center">
                        This action is <strong>irreversible</strong>!
                    </div>

                    <dl class="row">
                        <dt class="col-sm-4">Title:</dt>
                        <dd class="col-sm-8">@Model.Title</dd>

                        <dt class="col-sm-4">Categories:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Categories.Any())
                            {
                                @foreach (var cat in Model.Categories)
                                {
                                    <span class="badge bg-secondary">@cat.Name</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">No categories</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Date added:</dt>
                        <dd class="col-sm-8">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                    </dl>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="p-3 bg-light rounded mb-3">
                            <em>"@Model.Description"</em>
                        </div>
                    }

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />

                        <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-danger">Yes, delete the bookmark</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>