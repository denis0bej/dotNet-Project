@model dotNet_Project.Models.Bookmark

@{
    ViewData["Title"] = "Add a new Bookmark";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add a new Bookmark</h4>
                </div>
                <div class="card-body">
                    <form asp-controller="Bookmarks" asp-action="New" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Title</label>
                            <input asp-for="Title" class="form-control" placeholder="Ex: Smartest cat in Romania" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Select Categories</label>
                            <div class="card p-3 bg-light" style="max-height: 200px; overflow-y: auto;">
                                @if (ViewBag.CategoryList != null)
                                {
                                    @foreach (var category in (IEnumerable<SelectListItem>)ViewBag.CategoryList)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="selectedCategories"
                                                   value="@category.Value"
                                                   id="cat_@category.Value">
                                            <label class="form-check-label" for="cat_@category.Value">
                                                @category.Text
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small">You don't have any categories yet. Please create one first!</div>
                                }
                            </div>
                            <small class="text-muted">You can select multiple folders.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="What is this Bookmark about?"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MediaUrl" class="form-label">Media Content (Link)</label>
                            <input asp-for="MediaUrl" class="form-control" placeholder="https://..." />
                            <div class="form-text">You can add a video/image link (ex: YouTube).</div>
                            <span asp-validation-for="MediaUrl" class="text-danger"></span>
                        </div>
                        <div class="mb-3 form-check">
                            <input class="form-check-input" type="checkbox" asp-for="IsPublic" />
                            <label class="form-check-label" asp-for="IsPublic">
                                Public
                            </label>
                            <div class="form-text">
                                Check to make it visible to everyone.
                            </div>
                        </div>
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                            <button type="submit" class="btn btn-success">Save</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}