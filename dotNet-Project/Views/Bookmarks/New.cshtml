@model dotNet_Project.Models.Bookmark

@{
    ViewData["Title"] = "Adaugă Bookmark";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Adaugă un nou Bookmark</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Titlu</label>
                            <input asp-for="Title" class="form-control" placeholder="Ex: Tutorial ASP.NET Core" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">Categorie</label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.Categories">
                                <option value="">-- Selectează Categoria --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                            <small class="text-muted">Nu găsești categoria? Creează una nouă din meniu.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Descriere</label>
                            <div class="d-flex gap-2 mb-2">
                                <button type="button" class="btn btn-sm btn-outline-info" title="Funcționalitate AI (urmează a fi implementată)">
                                    <i class="bi bi-magic"></i> Sugerează cu AI
                                </button>
                            </div>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Despre ce este acest bookmark?"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MediaUrl" class="form-label">Conținut Media (Link)</label>
                            <input asp-for="MediaUrl" class="form-control" placeholder="https://..." />
                            <div class="form-text">Poți introduce un link direct către o imagine sau un video (ex: YouTube).</div>
                            <span asp-validation-for="MediaUrl" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="Index" class="btn btn-secondary">Înapoi la listă</a>
                            <button type="submit" class="btn btn-success">Salvează Bookmark</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
