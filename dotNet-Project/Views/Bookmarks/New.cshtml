@model dotNet_Project.Models.Bookmark

@{
    ViewData["Title"] = "New Bookmark";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Create New Bookmark</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-controller="Bookmarks" asp-action="New" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold">Title</label>
                            <input asp-for="Title" class="form-control" placeholder="E.g., My favorite tutorial" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>

                        <div class="card bg-light mb-4 border">
                            <div class="card-body">
                                <h6 class="card-title fw-bold mb-3">Add Media (Optional)</h6>

                                <div class="mb-3">
                                    <label asp-for="ImageUpload" class="form-label fw-bold">Upload Image</label>
                                    <input asp-for="ImageUpload" type="file" class="form-control" accept="image/*" />
                                    <div class="form-text text-muted">Upload a .jpg, .png, or .webp from your device.</div>
                                    <span asp-validation-for="ImageUpload" class="text-danger"></span>
                                </div>

                                <div class="text-center text-muted fw-bold my-3">- OR -</div>

                                <div class="mb-0">
                                    <label asp-for="MediaUrl" class="form-label fw-bold">External Link (YouTube / Image URL)</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-link-45deg"></i></span>
                                        <input asp-for="MediaUrl" class="form-control" placeholder="https://..." />
                                    </div>
                                    <div class="form-text text-muted">
                                        Paste a YouTube link here if you prefer video, or an external image link.
                                    </div>
                                    <span asp-validation-for="MediaUrl" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-end mb-2">
                            <label asp-for="Description" class="form-label fw-bold mb-0">Description</label>
                            <div>
                                <span id="ai-loading" class="text-success me-2 small fw-bold" style="display:none;">
                                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Thinking...
                                </span>
                                <button type="button" id="btn-generate-ai" class="btn btn-outline-success btn-sm border-0 bg-success bg-opacity-10 text-success fw-bold">
                                    <i class="bi bi-stars"></i> Auto-Complete with AI
                                </button>
                            </div>
                        </div>

                        <div class="mb-4">
                            <textarea asp-for="Description" class="form-control" rows="5" placeholder="What is this bookmark about?"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Tags (Generated by AI)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted">#</span>
                                <input type="text" id="TagsInput" name="TagString" class="form-control" placeholder="Tags will appear here..." />
                            </div>
                            <div class="form-text text-muted">Separate tags with commas.</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Select Categories</label>
                            <div class="card p-3 bg-light border" style="max-height: 200px; overflow-y: auto;">
                                @if (ViewBag.CategoryList != null)
                                {
                                    @foreach (var category in (IEnumerable<SelectListItem>)ViewBag.CategoryList)
                                    {
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="selectedCategories"
                                                   value="@category.Value"
                                                   id="cat_@category.Value">
                                            <label class="form-check-label" for="cat_@category.Value" style="cursor: pointer;">
                                                <i class="bi bi-folder text-warning me-1"></i> @category.Text
                                            </label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small">
                                        You don't have any categories yet.
                                        <a asp-controller="Categories" asp-action="New">Create one first!</a>
                                    </div>
                                }
                            </div>
                            <small class="text-muted">You can select multiple folders.</small>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold text-success">
                                <i class="bi bi-magic"></i> New Categories (AI Suggested)
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-plus-square"></i></span>
                                <input type="text" id="NewCategoriesInput" name="newCategoriesString" class="form-control border-success"
                                       placeholder="Categories that don't exist yet will appear here..." />
                            </div>
                            <div class="form-text text-muted">
                                Review these suggestions. New categories will be created automatically upon saving.
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" asp-for="IsPublic" checked />
                                <label class="form-check-label fw-bold" asp-for="IsPublic">Make this Public</label>
                            </div>
                            <div class="form-text">
                                If unchecked, only you (and Admins) can see this post.
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-5 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                            <button type="submit" class="btn btn-success px-4 fw-bold">
                                <i class="bi bi-check-lg"></i> Create Bookmark
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.getElementById('btn-generate-ai').addEventListener('click', async function () {
            // 1. Luăm valorile
            var title = document.querySelector('input[name="Title"]').value;
            var desc = document.querySelector('textarea[name="Description"]').value;

            // Validare simplă
            if (!title && !desc) {
                alert("Please enter a Title or Description so the AI can analyze it.");
                return;
            }

            // 2. UI Loading State
            var btn = document.getElementById('btn-generate-ai');
            var loading = document.getElementById('ai-loading');

            btn.disabled = true;
            loading.style.display = 'inline-block';

            try {
                // 3. Preluăm Tokenul CSRF
                const tokenElement = document.getElementsByName('__RequestVerificationToken')[0];
                const token = tokenElement ? tokenElement.value : '';

                // 4. Apelăm Backend-ul
                const response = await fetch('/Bookmarks/SuggestMetadata', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify({ title: title, description: desc })
                });

                if (response.ok) {
                    const data = await response.json();

                    // A. Completăm Tag-urile
                    const tagsInput = document.getElementById('TagsInput');
                    if (tagsInput) {
                        tagsInput.value = data.tags;
                        tagsInput.style.backgroundColor = "#fff3cd";
                        setTimeout(() => tagsInput.style.backgroundColor = "", 1000);
                    }

                    // B. Bifăm Categoriile EXISTENTE
                    if (data.categoryIds && data.categoryIds.length > 0) {
                        data.categoryIds.forEach(id => {
                            const targetCheckbox = document.getElementById('cat_' + id);
                            if (targetCheckbox) {
                                targetCheckbox.checked = true;
                                targetCheckbox.parentElement.scrollIntoView({ behavior: 'smooth', block: 'nearest' });

                                const label = document.querySelector(`label[for="cat_${id}"]`);
                                if(label) {
                                    label.classList.add('text-success', 'fw-bold');
                                    setTimeout(() => label.classList.remove('text-success', 'fw-bold'), 3000);
                                }
                            }
                        });
                    }

                    // C. Completăm Categoriile NOI
                    const newCatInput = document.getElementById('NewCategoriesInput');
                    if (data.newCategories && data.newCategories.length > 0) {
                        newCatInput.value = data.newCategories.join(", ");
                        newCatInput.style.backgroundColor = "#d1e7dd";
                        setTimeout(() => newCatInput.style.backgroundColor = "", 1500);
                    }

                } else {
                    alert("Error communicating with AI service.");
                }
            } catch (error) {
                console.error("Network error:", error);
                alert("Something went wrong.");
            } finally {
                // 5. Reset UI
                btn.disabled = false;
                loading.style.display = 'none';
            }
        });
    </script>
}