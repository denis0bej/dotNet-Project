@using dotNet_Project.Models
@model dotNet_Project.Models.UserProfileViewModel

@{
    ViewData["Title"] = Model.FullName + "'s Profile";
    // Logică simplă pentru a menține tab-ul activ după paginare
    var activeTab = ViewBag.ActiveTab as string ?? "collections";
    var collectionsClass = activeTab == "collections" ? "active show" : "";
    var bookmarksClass = activeTab == "bookmarks" ? "active show" : "";
    var collectionsLinkClass = activeTab == "collections" ? "active" : "";
    var bookmarksLinkClass = activeTab == "bookmarks" ? "active" : "";
}

<div class="container mt-5">
    <div class="card shadow-sm mb-4 border-0 bg-light">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img src="@Model.ProfilePicture" alt="Profile" class="rounded-circle img-thumbnail shadow-sm" style="width: 180px; height: 180px; object-fit: cover;">
                    }
                    else
                    {
                        <img src="https://placehold.co/180" alt="No Image" class="rounded-circle img-thumbnail shadow-sm" />
                    }
                </div>
                <div class="col-md-9">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h1 class="display-6 fw-bold text-dark">@Model.FullName</h1>
                            <p class="text-muted mb-3">@Model.Email</p>
                        </div>
                        @if (Model.IsOwner)
                        {
                            <a asp-action="Edit" class="btn btn-outline-primary">
                                <i class="bi bi-pencil"></i> Edit Profile
                            </a>
                        }
                    </div>
                    <hr />
                    <div class="profile-description">
                        <h5 class="text-secondary text-uppercase fs-6">About Me</h5>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <p class="lead fs-6">@Model.Description</p>
                        }
                        else
                        {
                            <p class="text-muted font-italic">No description added yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-4" id="profileTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold @collectionsLinkClass" id="collections-tab" data-bs-toggle="tab" data-bs-target="#collections" type="button" role="tab">
                <i class="bi bi-folder"></i> Collections
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold @bookmarksLinkClass" id="bookmarks-tab" data-bs-toggle="tab" data-bs-target="#bookmarks" type="button" role="tab">
                <i class="bi bi-bookmark-heart"></i> Bookmarks
            </button>
        </li>
    </ul>

    <div class="tab-content" id="profileTabsContent">

        <div class="tab-pane fade @collectionsClass" id="collections" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="text-muted">My Collections</h4>
                @if (Model.IsOwner)
                {
                    <a asp-controller="Categories" asp-action="New" class="btn btn-sm btn-success">+ New Category</a>
                }
            </div>

            @if (!Model.Categories.Any())
            {
                <div class="alert alert-info text-center">This user has no visible collections.</div>
            }
            else
            {
                <div class="row">
                    @foreach (var category in Model.Categories)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm border-0 transition-hover">
                                <div class="card-body">
                                    <h5 class="card-title fw-bold">
                                        <a asp-controller="Categories" asp-action="Show" asp-route-id="@category.Id" class="text-decoration-none text-dark stretched-link">
                                            <i class="bi bi-folder2-open text-warning me-2"></i> @category.Name
                                        </a>
                                    </h5>
                                    @if (Model.IsOwner)
                                    {
                                        <div class="mt-2">
                                            <span class="badge @(category.IsPublic ? "bg-success" : "bg-secondary")">
                                                @(category.IsPublic ? "Public" : "Private")
                                            </span>
                                        </div>
                                    }
                                </div>
                                @if (Model.IsOwner)
                                {
                                    <div class="card-footer bg-white border-top-0 d-flex gap-2 position-relative" style="z-index: 2;">
                                        <a asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-light border w-50">Edit</a>
                                        <a asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-danger w-50">Delete</a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-center mt-3">
                    @{
                        var prevCatDisabled = !Model.Categories.HasPreviousPage ? "disabled" : "";
                        var nextCatDisabled = !Model.Categories.HasNextPage ? "disabled" : "";
                    }
                    <a asp-action="Show"
                       asp-route-id="@Model.UserId"
                       asp-route-categoryPage="@(Model.Categories.PageIndex - 1)"
                       asp-route-bookmarkPage="@Model.Bookmarks.PageIndex"
                       class="btn btn-sm btn-outline-secondary me-2 @prevCatDisabled">
                        &laquo; Previous
                    </a>
                    <span class="align-self-center mx-2 small text-muted">
                        Page @Model.Categories.PageIndex of @Model.Categories.TotalPages
                    </span>
                    <a asp-action="Show"
                       asp-route-id="@Model.UserId"
                       asp-route-categoryPage="@(Model.Categories.PageIndex + 1)"
                       asp-route-bookmarkPage="@Model.Bookmarks.PageIndex"
                       class="btn btn-sm btn-outline-secondary @nextCatDisabled">
                        Next &raquo;
                    </a>
                </div>
            }
        </div>

        <div class="tab-pane fade @bookmarksClass" id="bookmarks" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-4 mt-3">
                <h4 class="text-muted mb-0">My Bookmarks</h4>
                @if (Model.IsOwner)
                {
                    <a asp-controller="Bookmarks" asp-action="New" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> New Bookmark
                    </a>
                }
            </div>

            @if (!Model.Bookmarks.Any())
            {
                <div class="alert alert-light border text-center p-5">
                    <p class="mb-0 text-muted">No bookmarks found.</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var item in Model.Bookmarks)
                    {
                        var heartClass = item.IsLikedByCurrentUser ? "bi-heart-fill text-danger" : "bi-heart";

                        <div class="col-md-4 mb-4">
                            <div class="card post-card">

                                <a asp-controller="Bookmarks" asp-action="Show" asp-route-id="@item.Id" class="card-main-link" aria-label="@item.Title"></a>

                                @if (Model.IsOwner)
                                {
                                    <div class="position-absolute top-0 start-0 p-3 bring-to-front d-flex gap-2">
                                        <a asp-controller="Bookmarks" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-light btn-sm rounded-circle shadow-sm" title="Edit" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-pencil-fill text-dark small"></i>
                                        </a>
                                        <a asp-controller="Bookmarks" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-light btn-sm rounded-circle shadow-sm" title="Delete" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-trash-fill text-danger small"></i>
                                        </a>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                                {
                                    <img src="@item.MediaUrl" class="post-img-bg" alt="@item.Title">
                                }
                                else if (item.MediaUrl != null && item.MediaUrl.Contains("youtube"))
                                {
                                    <div class="post-placeholder-bg bg-black">
                                        <i class="bi bi-youtube text-danger fs-1"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="post-placeholder-bg">
                                        <span class="fs-1 text-muted"><i class="bi bi-bookmark-star"></i></span>
                                    </div>
                                }

                                <div class="post-badges-top bring-to-front">
                                    @foreach (var catName in item.CategoryNames)
                                    {
                                        <span class="badge bg-light text-dark shadow-sm opacity-75">
                                            @catName
                                        </span>
                                    }
                                </div>

                                <div class="post-content-overlay">
                                    <div class="d-flex justify-content-between align-items-center">

                                        <div class="d-flex flex-column pe-3" style="min-width: 0;">
                                            <h5 class="card-title fw-bold text-truncate w-100 mb-1">
                                                @item.Title
                                            </h5>

                                            <div class="bring-to-front">
                                                @if (item.IsPublic)
                                                {
                                                    <span class="badge bg-success bg-opacity-75 text-white shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                                        <i class="bi bi-globe-americas"></i> Public
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary bg-opacity-75 text-white shadow-sm d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                                        <i class="bi bi-lock-fill"></i> Private
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <div class="d-flex align-items-center cursor-pointer like-container bring-to-front flex-shrink-0" onclick="toggleLike(@item.Id)">
                                            <i id="heart-icon-@item.Id" class="bi @heartClass fs-3 me-1 like-icon"></i>
                                            <span id="like-count-@item.Id" class="fw-bold">@item.LikeCount</span>
                                        </div>

                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-center mt-4">
                    @{
                        var prevBkDisabled = !Model.Bookmarks.HasPreviousPage ? "disabled" : "";
                        var nextBkDisabled = !Model.Bookmarks.HasNextPage ? "disabled" : "";
                    }
                    <a asp-action="Show"
                       asp-route-id="@Model.UserId"
                       asp-route-bookmarkPage="@(Model.Bookmarks.PageIndex - 1)"
                       asp-route-categoryPage="@Model.Categories.PageIndex"
                       class="btn btn-outline-secondary me-2 @prevBkDisabled">
                        <i class="bi bi-arrow-left"></i> Previous
                    </a>

                    <span class="align-self-center mx-3 fw-bold text-muted">
                        Page @Model.Bookmarks.PageIndex of @Model.Bookmarks.TotalPages
                    </span>

                    <a asp-action="Show"
                       asp-route-id="@Model.UserId"
                       asp-route-bookmarkPage="@(Model.Bookmarks.PageIndex + 1)"
                       asp-route-categoryPage="@Model.Categories.PageIndex"
                       class="btn btn-outline-secondary @nextBkDisabled">
                        Next <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function toggleLike(bookmarkId) {
             /* ... Codul JS standard ... */
        }
    </script>
}