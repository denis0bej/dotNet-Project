@using dotNet_Project.Models
@model dotNet_Project.Models.UserProfileViewModel

@{
    ViewData["Title"] = Model.FullName + "'s Profile";

    // Logică pentru tab-ul activ
    var activeTab = ViewBag.ActiveTab as string ?? "collections";
    var collectionsClass = activeTab == "collections" ? "active show" : "";
    var bookmarksClass = activeTab == "bookmarks" ? "active show" : "";
    var collectionsLinkClass = activeTab == "collections" ? "active" : "";
    var bookmarksLinkClass = activeTab == "bookmarks" ? "active" : "";
}

<div class="container mt-5 mb-5">

    <div class="card shadow-sm mb-5 border-0 bg-white">
        <div class="card-body p-4">
            <div class="row align-items-center">
                <div class="col-md-3 text-center mb-3 mb-md-0">
                    @if (!string.IsNullOrEmpty(Model.ProfilePicture))
                    {
                        <img src="@Model.ProfilePicture" alt="Profile" class="rounded-circle shadow-sm"
                             style="width: 150px; height: 150px; object-fit: cover; border: 4px solid #fff;">
                    }
                    else
                    {
                        <div class="rounded-circle shadow-sm d-flex align-items-center justify-content-center bg-light mx-auto"
                             style="width: 150px; height: 150px; border: 4px solid #fff;">
                            <i class="bi bi-person text-secondary display-1"></i>
                        </div>
                    }
                </div>
                <div class="col-md-9">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <h1 class="display-6 fw-bold text-dark mb-0">@Model.FullName</h1>
                            <p class="text-muted mb-3">@Model.Email</p>
                        </div>
                        @if (Model.IsOwner)
                        {
                            <a asp-action="Edit" class="btn btn-outline-primary rounded-pill px-4">
                                <i class="bi bi-pencil"></i> Edit Profile
                            </a>
                        }

                        @if (User.IsInRole("Admin") && Model.UserId != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value)
                        {
                            <div class="mt-2">
                                <form asp-controller="Profiles" asp-action="DeleteUser" asp-route-id="@Model.UserId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger rounded-pill px-4"
                                            onclick="return confirm('Ești sigur că vrei să ștergi acest utilizator? Această acțiune este ireversibilă și va șterge toate datele lui!');">
                                        <i class="bi bi-trash"></i> Delete User
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                    <hr class="my-4" />
                    <div class="profile-description">
                        <h6 class="text-uppercase text-muted small fw-bold mb-2">About Me</h6>
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <p class="text-dark mb-0" style="white-space: pre-wrap;">@Model.Description</p>
                        }
                        else
                        {
                            <p class="text-muted fst-italic mb-0">No description added yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs mb-4 border-bottom-0" id="profileTabs" role="tablist">
        <li class="nav-item me-2" role="presentation">
            <button class="nav-link fw-bold px-4 py-2 border-0 rounded-top @collectionsLinkClass"
                    id="collections-tab" data-bs-toggle="tab" data-bs-target="#collections" type="button" role="tab"
                    style="background-color: @(activeTab == "collections" ? "transparent" : "#f8f9fa"); border-bottom: @(activeTab == "collections" ? "3px solid #0d6efd" : "none") !important;">
                <i class="bi bi-folder2-open me-1"></i> Collections
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4 py-2 border-0 rounded-top @bookmarksLinkClass"
                    id="bookmarks-tab" data-bs-toggle="tab" data-bs-target="#bookmarks" type="button" role="tab"
                    style="background-color: @(activeTab == "bookmarks" ? "transparent" : "#f8f9fa"); border-bottom: @(activeTab == "bookmarks" ? "3px solid #0d6efd" : "none") !important;">
                <i class="bi bi-bookmark-heart me-1"></i> Bookmarks
            </button>
        </li>
    </ul>

    <div class="tab-content" id="profileTabsContent">

        <div class="tab-pane fade @collectionsClass" id="collections" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="text-dark fw-bold mb-0">Collections</h4>
                @if (Model.IsOwner)
                {
                    <a asp-controller="Categories" asp-action="New" class="btn btn-success rounded-pill px-3 shadow-sm">
                        <i class="bi bi-folder-plus"></i> New Category
                    </a>
                }
            </div>

            @if (!Model.Categories.Any())
            {
                <div class="text-center py-5 bg-light rounded-3 border border-dashed">
                    <i class="bi bi-folder-x display-4 text-muted opacity-50"></i>
                    <p class="mt-3 text-muted">No collections found.</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var category in Model.Categories)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card h-100 shadow-sm border-0 hover-shadow transition-hover">
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <i class="bi bi-folder-fill text-warning display-6"></i>
                                        @if (Model.IsOwner)
                                        {
                                            <span class="badge rounded-pill @(category.IsPublic ? "bg-success bg-opacity-10 text-success" : "bg-secondary bg-opacity-10 text-secondary")">
                                                @(category.IsPublic ? "Public" : "Private")
                                            </span>
                                        }
                                    </div>

                                    <h5 class="card-title fw-bold mt-2">
                                        <a asp-controller="Categories" asp-action="Show" asp-route-id="@category.Id" class="text-decoration-none text-dark stretched-link">
                                            @category.Name
                                        </a>
                                    </h5>
                                    <p class="text-muted small mb-0">View collection items &rarr;</p>
                                </div>

                                @if (Model.IsOwner)
                                {
                                    <div class="card-footer bg-white border-top-0 d-flex justify-content-between pt-0 pb-3 position-relative" style="z-index: 2;">
                                        <a asp-controller="Categories" asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-secondary rounded-pill px-3">Edit</a>
                                        <a asp-controller="Categories" asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-center mt-3">
                    @{
                        var prevCatDisabled = !Model.Categories.HasPreviousPage ? "disabled" : "";
                        var nextCatDisabled = !Model.Categories.HasNextPage ? "disabled" : "";
                    }
                    <a asp-action="Show" asp-route-id="@Model.UserId" asp-route-categoryPage="@(Model.Categories.PageIndex - 1)" asp-route-bookmarkPage="@Model.Bookmarks.PageIndex"
                       class="btn btn-sm btn-outline-secondary me-2 @prevCatDisabled">
                        &laquo; Previous
                    </a>
                    <span class="align-self-center mx-2 small text-muted">
                        Page @Model.Categories.PageIndex of @Model.Categories.TotalPages
                    </span>
                    <a asp-action="Show" asp-route-id="@Model.UserId" asp-route-categoryPage="@(Model.Categories.PageIndex + 1)" asp-route-bookmarkPage="@Model.Bookmarks.PageIndex"
                       class="btn btn-sm btn-outline-secondary @nextCatDisabled">
                        Next &raquo;
                    </a>
                </div>
            }
        </div>

        <div class="tab-pane fade @bookmarksClass" id="bookmarks" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="text-dark fw-bold mb-0">Bookmarks</h4>
                @if (Model.IsOwner)
                {
                    <a asp-controller="Bookmarks" asp-action="New" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-plus-lg me-1"></i> New Bookmark
                    </a>
                }
            </div>

            @if (!Model.Bookmarks.Any())
            {
                <div class="text-center py-5 bg-light rounded-3 border border-dashed">
                    <i class="bi bi-bookmarks display-4 text-muted opacity-50"></i>
                    <p class="mt-3 text-muted">No bookmarks yet.</p>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var item in Model.Bookmarks)
                    {
                        var heartClass = item.IsLikedByCurrentUser ? "bi-heart-fill text-danger" : "bi-heart text-dark";

                        <div class="col-md-4 mb-4">
                            <div class="card post-card bg-white">

                                <a asp-controller="Bookmarks" asp-action="Show" asp-route-id="@item.Id" class="card-main-link" aria-label="@item.Title"></a>

                                @if (Model.IsOwner)
                                {
                                    <div class="position-absolute top-0 start-0 p-3 bring-to-front d-flex gap-2">
                                        <a asp-controller="Bookmarks" asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-light btn-sm rounded-circle shadow-sm opacity-75 hover-opacity-100 d-flex align-items-center justify-content-center"
                                           title="Edit" style="width: 32px; height: 32px;">
                                            <i class="bi bi-pencil-fill text-dark small"></i>
                                        </a>
                                        <a asp-controller="Bookmarks" asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-light btn-sm rounded-circle shadow-sm opacity-75 hover-opacity-100 d-flex align-items-center justify-content-center"
                                           title="Delete" style="width: 32px; height: 32px;">
                                            <i class="bi bi-trash-fill text-danger small"></i>
                                        </a>
                                    </div>
                                }

                                @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg") || item.MediaUrl.EndsWith(".webp")))
                                {
                                    <img src="@item.MediaUrl" class="post-img-bg" alt="@item.Title">
                                }
                                else if (item.MediaUrl != null && item.MediaUrl.Contains("youtube"))
                                {
                                    <div class="post-placeholder-bg bg-light">
                                        <i class="bi bi-youtube text-danger fs-1"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="post-placeholder-bg bg-light">
                                        <span class="fs-1 text-muted"><i class="bi bi-bookmark-star"></i></span>
                                    </div>
                                }

                                <div class="post-badges-top bring-to-front">
                                    @foreach (var catName in item.CategoryNames.Take(2))
                                    {
                                        <span class="badge bg-white text-dark shadow-sm border">
                                            @catName
                                        </span>
                                    }
                                </div>

                                <div class="post-content-overlay d-flex flex-column justify-content-end">

                                    <div class="d-flex justify-content-between align-items-end bring-to-front">
                                        <div class="d-flex flex-column pe-2" style="min-width: 0;">

                                            <h5 class="card-title fw-bold text-truncate w-100 mb-1 text-dark">
                                                @item.Title
                                            </h5>

                                            <div class="mb-1">
                                                @if (item.IsPublic)
                                                {
                                                    <span class="badge bg-success bg-opacity-10 text-success border border-success" style="font-size: 0.65rem;">
                                                        Public
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-dark text-white border border-secondary" style="font-size: 0.65rem;">
                                                        Private
                                                    </span>
                                                }
                                            </div>

                                            <small class="text-muted">
                                                Added on @item.CreatedAt.ToString("dd MMM yyyy")
                                            </small>
                                        </div>

                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <div class="d-flex align-items-center cursor-pointer like-container" onclick="toggleLike(@item.Id)">
                                                <i id="heart-icon-@item.Id" class="bi @heartClass fs-3 me-1 like-icon"></i>
                                                <span id="like-count-@item.Id" class="fw-bold text-dark">@item.LikeCount</span>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-center mt-4">
                    @{
                        var prevBkDisabled = !Model.Bookmarks.HasPreviousPage ? "disabled" : "";
                        var nextBkDisabled = !Model.Bookmarks.HasNextPage ? "disabled" : "";
                    }
                    <a asp-action="Show" asp-route-id="@Model.UserId" asp-route-bookmarkPage="@(Model.Bookmarks.PageIndex - 1)" asp-route-categoryPage="@Model.Categories.PageIndex"
                       class="btn btn-outline-secondary me-2 @prevBkDisabled">
                        <i class="bi bi-arrow-left"></i> Previous
                    </a>
                    <span class="align-self-center mx-3 fw-bold text-muted">
                        Page @Model.Bookmarks.PageIndex of @Model.Bookmarks.TotalPages
                    </span>
                    <a asp-action="Show" asp-route-id="@Model.UserId" asp-route-bookmarkPage="@(Model.Bookmarks.PageIndex + 1)" asp-route-categoryPage="@Model.Categories.PageIndex"
                       class="btn btn-outline-secondary @nextBkDisabled">
                        Next <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function toggleLike(bookmarkId) {
            const tokenInput = document.getElementsByName('__RequestVerificationToken')[0];
            if (!tokenInput) return;

            try {
                const heartIcon = document.getElementById(`heart-icon-${bookmarkId}`);
                const countSpan = document.getElementById(`like-count-${bookmarkId}`);

                const response = await fetch('/Bookmarks/ToggleLike', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenInput.value
                    },
                    body: JSON.stringify(bookmarkId)
                });

                if (response.ok) {
                    const data = await response.json();
                    countSpan.innerText = data.newCount;

                    if (data.isLiked) {
                        heartIcon.classList.remove('bi-heart', 'text-dark');
                        heartIcon.classList.add('bi-heart-fill', 'text-danger', 'animate-like');
                        setTimeout(() => heartIcon.classList.remove('animate-like'), 400);
                    } else {
                        heartIcon.classList.add('bi-heart', 'text-dark');
                        heartIcon.classList.remove('bi-heart-fill', 'text-danger');
                    }
                }
            } catch (error) { console.error("Error:", error); }
        }
    </script>
}