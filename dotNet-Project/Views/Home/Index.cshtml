@using dotNet_Project.Models
@using System.Security.Claims
@model PaginatedList<BookmarkCardViewModel>

@{
    ViewData["Title"] = "Home Feed";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole("Admin");
}

@Html.AntiForgeryToken()

<div class="text-center mb-5 mt-4">
    <h1 class="display-4 fw-light">Discover New Ideas</h1>
    <p class="lead text-muted">Cele mai interesante bookmark-uri din comunitate</p>
</div>

<div class="d-flex justify-content-center mb-5">
    <div class="btn-group shadow-sm" role="group">
        <a asp-action="Index"
           asp-route-sortOrder="Date"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn @(ViewData["CurrentSort"] == "Date" || ViewData["CurrentSort"] == null ? "btn-dark" : "btn-outline-dark")">
            <i class="bi bi-clock"></i> Most Recent
        </a>

        <a asp-action="Index"
           asp-route-sortOrder="Popular"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn @(ViewData["CurrentSort"] == "Popular" ? "btn-danger" : "btn-outline-danger")">
            <i class="bi bi-fire"></i> Most Popular
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h3 class="mt-3 text-muted">Nu am găsit postări publice momentan.</h3>
        @if (ViewData["CurrentFilter"] != null)
        {
            <p>Încearcă să cauți altceva.</p>
        }
    </div>
}
else
{
    <div class="container">
        <div class="row">
            @foreach (var item in Model)
            {
                var heartClass = item.IsLikedByCurrentUser ? "bi-heart-fill text-danger" : "bi-heart";

                <div class="col-md-6 col-lg-4 mb-4" id="card-post-@item.Id">
                    <div class="card h-100 shadow-sm border-0 hover-effect">

                        <a asp-controller="Bookmarks" asp-action="Show" asp-route-id="@item.Id" class="text-decoration-none">
                            <div style="position: relative; overflow: hidden; height: 200px;">
                                @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                                {
                                    <img src="@item.MediaUrl" class="card-img-top h-100 w-100" style="object-fit: cover;" alt="@item.Title">
                                }
                                else if (item.MediaUrl != null && item.MediaUrl.Contains("youtube"))
                                {
                                    <div class="h-100 w-100 bg-black d-flex align-items-center justify-content-center">
                                        <i class="bi bi-youtube text-danger display-4"></i>
                                    </div>
                                }
                                else
                                {
                                    <div class="h-100 w-100 bg-light d-flex align-items-center justify-content-center">
                                        <i class="bi bi-bookmark-star text-muted display-4"></i>
                                    </div>
                                }
                            </div>
                        </a>

                        <div class="card-body">
                            <div class="mb-2">
                                @foreach (var catName in item.CategoryNames.Take(3))
                                {
                                    <span class="badge bg-light text-dark border me-1">@catName</span>
                                }
                            </div>

                            <h5 class="card-title fw-bold text-truncate">
                                <a asp-controller="Bookmarks" asp-action="Show" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                    @item.Title
                                </a>
                            </h5>

                            <div class="d-flex align-items-center mb-3">
                                @if (!string.IsNullOrEmpty(item.UserProfilePicture))
                                {
                                    <img src="@item.UserProfilePicture" class="rounded-circle me-2" style="width: 24px; height: 24px; object-fit: cover;" alt="User">
                                }
                                else
                                {
                                    <i class="bi bi-person-circle text-secondary me-2"></i>
                                }
                                <small class="text-muted text-truncate" style="max-width: 150px;">
                                    @item.UserDisplayName
                                </small>
                            </div>

                            <p class="card-text text-muted small text-truncate">
                                @item.Description
                            </p>
                        </div>

                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center pb-3">
                            
                            <div class="d-flex align-items-center">
                                <a asp-controller="Bookmarks" asp-action="Show" asp-route-id="@item.Id" class="btn btn-primary rounded-pill px-4 me-2">
                                    Vezi
                                </a>

                                @if (isAdmin)
                                {
                                    <button onclick="deletePostAjax(@item.Id)" class="btn btn-outline-danger rounded-circle" title="Șterge ca Admin">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }
                            </div>

                            <div class="d-flex align-items-center cursor-pointer" onclick="toggleLike(@item.Id)" style="cursor: pointer;">
                                <i id="heart-icon-@item.Id" class="bi @heartClass fs-4 me-1 text-danger"></i>
                                <span id="like-count-@item.Id" class="fw-bold text-dark">@item.LikeCount</span>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    </div>

    <div class="d-flex justify-content-center mt-4 mb-5">
        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }

        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           class="btn btn-outline-secondary me-2 @prevDisabled">
            <i class="bi bi-arrow-left"></i> Previous
        </a>

        <span class="align-self-center mx-3 fw-bold text-muted">
            Page @Model.PageIndex of @Model.TotalPages
        </span>

        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           class="btn btn-outline-secondary @nextDisabled">
            Next <i class="bi bi-arrow-right"></i>
        </a>
    </div>
}

@section Scripts {
    <script>
        // 1. LIKE FUNCTION
        async function toggleLike(bookmarkId) {
            const tokenInput = document.getElementsByName('__RequestVerificationToken')[0];
            if (!tokenInput) {
                alert("Trebuie să fii autentificat pentru a da like!");
                return;
            }

            try {
                const heartIcon = document.getElementById(`heart-icon-${bookmarkId}`);
                const countSpan = document.getElementById(`like-count-${bookmarkId}`);
                
                const response = await fetch('/Bookmarks/ToggleLike', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenInput.value
                    },
                    body: JSON.stringify(bookmarkId)
                });

                if (response.ok) {
                    const data = await response.json();
                    countSpan.innerText = data.newCount;

                    if (data.isLiked) {
                        heartIcon.classList.remove('bi-heart');
                        heartIcon.classList.add('bi-heart-fill');
                    } else {
                        heartIcon.classList.add('bi-heart');
                        heartIcon.classList.remove('bi-heart-fill');
                    }
                }
            } catch (error) {
                console.error("Eroare like:", error);
            }
        }

        // 2. ADMIN DELETE (AJAX)
        async function deletePostAjax(bookmarkId) {
            if (!confirm("Ești sigur că vrei să ștergi această postare definitiv (Admin)?")) {
                return;
            }

            const tokenInput = document.getElementsByName('__RequestVerificationToken')[0];

            try {
                // Folosim FormData pentru a trimite ID-ul simplu
                const formData = new FormData();
                formData.append('id', bookmarkId);

                const response = await fetch('/Bookmarks/DeleteAjax', {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': tokenInput ? tokenInput.value : ''
                    },
                    body: formData
                });

                if (response.ok) {
                    const data = await response.json();
                    if (data.success) {
                        alert(data.message);
                        // Ștergem cardul din DOM fără reload
                        const cardElement = document.getElementById(`card-post-${bookmarkId}`);
                        if (cardElement) {
                            cardElement.remove();
                        }
                    } else {
                        alert("Eroare: " + data.message);
                    }
                } else {
                    alert("A apărut o eroare la comunicarea cu serverul.");
                }
            } catch (error) {
                console.error("Eroare delete:", error);
                alert("Eroare de rețea.");
            }
        }
    </script>
}