@using System.Security.Claims
@using dotNet_Project.Models
@model PaginatedList<dotNet_Project.Models.BookmarkCardViewModel>

@{
    ViewData["Title"] = "Home Feed";
}

@Html.AntiForgeryToken()

<div class="container mt-4 mb-4 text-center">
    <h1 class="display-5 mb-3">Discover New Ideas</h1>

    <div class="btn-group" role="group">
        <a asp-action="Index" asp-route-sortOrder="Recent"
           class="btn @(ViewBag.CurrentSort != "Popular" ? "btn-dark" : "btn-outline-dark")">
            <i class="bi bi-clock"></i> Most Recent
        </a>
        <a asp-action="Index" asp-route-sortOrder="Popular"
           class="btn @(ViewBag.CurrentSort == "Popular" ? "btn-danger" : "btn-outline-danger")">
            <i class="bi bi-fire"></i> Most Popular
        </a>
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center">
            There are no public bookmarks at the moment.
            Be the first to post in a public category!
        </div>
    }

    <div class="row">
        @foreach (var item in Model)
        {
            var heartClass = item.IsLikedByCurrentUser ? "bi-heart-fill text-danger" : "bi-heart";

            <div class="col-md-4 mb-4">
                <div class="card post-card">

                    <a asp-controller="Bookmarks" asp-action="Show" asp-route-id="@item.Id" class="card-main-link" aria-label="@item.Title"></a>

                    @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                    {
                        <img src="@item.MediaUrl" class="post-img-bg" alt="@item.Title">
                    }
                    else if (item.MediaUrl != null && item.MediaUrl.Contains("youtube"))
                    {
                        <div class="post-placeholder-bg bg-black">
                            <i class="bi bi-youtube text-danger fs-1"></i>
                        </div>
                    }
                    else
                    {
                        <div class="post-placeholder-bg">
                            <span class="fs-1 text-muted"><i class="bi bi-bookmark-star"></i></span>
                        </div>
                    }

                    <div class="post-badges-top bring-to-front">
                        @foreach (var catName in item.CategoryNames)
                        {
                            <span class="badge bg-light text-dark shadow-sm opacity-75">
                                @catName
                            </span>
                        }
                    </div>

                    <div class="post-content-overlay">

                        <div class="d-flex justify-content-between align-items-center">

                            <div class="d-flex flex-column pe-3" style="min-width: 0;">

                                <h5 class="card-title fw-bold text-truncate w-100 mb-1">
                                    @item.Title
                                </h5>

                                <div class="d-flex align-items-center bring-to-front position-relative">
                                    @if (!string.IsNullOrEmpty(item.UserProfilePicture))
                                    {
                                        <img src="@item.UserProfilePicture" class="user-avatar-small" alt="User">
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle me-1 text-muted fs-5"></i>
                                    }

                                    <span class="card-subtitle text-muted small mb-0 fw-semibold text-truncate">
                                        @item.UserDisplayName
                                    </span>
                                </div>
                            </div>

                            @if (User.Identity.IsAuthenticated)
                            {
                                <div class="d-flex align-items-center cursor-pointer like-container bring-to-front flex-shrink-0" onclick="toggleLike(@item.Id)">
                                    <i id="heart-icon-@item.Id" class="bi @heartClass fs-3 me-1 like-icon"></i> <span id="like-count-@item.Id" class="fw-bold">@item.LikeCount</span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center bring-to-front flex-shrink-0">
                                    <a asp-area="Identity" asp-page="/Account/Login" class="text-decoration-none text-dark">
                                        <i class="bi bi-heart fs-3 me-1"></i>
                                        <span class="fw-bold">@item.LikeCount</span>
                                    </a>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-4 mb-5">
        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }

        <a asp-action="Index"
           asp-route-sortOrder="@ViewBag.CurrentSort"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           class="btn btn-outline-secondary me-2 @prevDisabled">
            <i class="bi bi-arrow-left"></i> Previous Page
        </a>

        <span class="align-self-center mx-3 fw-bold text-muted">
            Page @Model.PageIndex of @Model.TotalPages
        </span>

        <a asp-action="Index"
           asp-route-sortOrder="@ViewBag.CurrentSort"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           class="btn btn-outline-secondary @nextDisabled">
            Next Page <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        // Asigură-te că funcția toggleLike există și aici,
        // similar cu cea din Bookmarks/Index.cshtml
        async function toggleLike(bookmarkId) {
             try {
                 const heartIcon = document.getElementById(`heart-icon-${bookmarkId}`);
                 const countSpan = document.getElementById(`like-count-${bookmarkId}`);
                 const token = document.getElementsByName('__RequestVerificationToken')[0]?.value;

                 const response = await fetch('/Bookmarks/ToggleLike', {
                     method: 'POST',
                     headers: {
                         'Content-Type': 'application/json',
                         'RequestVerificationToken': token
                     },
                     body: JSON.stringify(bookmarkId)
                 });

                 if (response.ok) {
                     const data = await response.json();
                     countSpan.innerText = data.newCount;

                     if (data.isLiked) {
                         heartIcon.classList.remove('bi-heart');
                         heartIcon.classList.add('bi-heart-fill', 'text-danger');
                         heartIcon.classList.add('animate-like');
                         setTimeout(() => { heartIcon.classList.remove('animate-like'); }, 400);
                     } else {
                         heartIcon.classList.add('bi-heart');
                         heartIcon.classList.remove('bi-heart-fill', 'text-danger');
                     }
                 }
             } catch (error) {
                 console.error("Network error:", error);
             }
         }
    </script>
}