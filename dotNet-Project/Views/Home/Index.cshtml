@using System.Security.Claims
@model IEnumerable<dotNet_Project.Models.Bookmark>

@{
    ViewData["Title"] = "Home Feed";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

@Html.AntiForgeryToken()

<div class="container mt-4 mb-4 text-center">

    @if (ViewData["CurrentFilter"] != null)
    {
        <h1 class="display-6 mb-3">Rezultate pentru: <span class="text-primary">"@ViewData["CurrentFilter"]"</span></h1>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary mb-3">
            <i class="bi bi-x-circle"></i> Resetează Filtrele
        </a>
    }
    else
    {
        <h1 class="display-5 mb-3">Descoperă Idei Noi</h1>
    }

    <div class="btn-group" role="group">
        <a asp-action="Index"
           asp-route-sortOrder="Recent"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn @(ViewBag.CurrentSort != "Popular" ? "btn-dark" : "btn-outline-dark")">
            <i class="bi bi-clock"></i> Cele mai Recente
        </a>
        <a asp-action="Index"
           asp-route-sortOrder="Popular"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn @(ViewBag.CurrentSort == "Popular" ? "btn-danger" : "btn-outline-danger")">
            <i class="bi bi-fire"></i> Cele mai Populare
        </a>
    </div>
</div>

<div class="container">
    @if (!Model.Any())
    {
        @if (ViewData["CurrentFilter"] != null)
        {
            <div class="alert alert-light text-center p-5 border shadow-sm">
                <i class="bi bi-search display-1 text-muted mb-3 d-block"></i>
                <h4 class="text-danger">Nu am găsit nimic pentru "@ViewData["CurrentFilter"]"</h4>
                <p class="text-muted">Încearcă alte cuvinte cheie sau verifică ortografia.</p>
                <a asp-action="Index" class="btn btn-primary mt-3">Înapoi la toate Pin-urile</a>
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center">
                Nu există bookmark-uri publice momentan. Fii tu primul care postează într-o categorie publică!
            </div>
        }
    }

    <div class="row">
        @foreach (var item in Model)
        {
            // Calculăm starea de Like
            var isLikedByMe = item.Votes.Any(v => v.UserId == currentUserId);
            var heartClass = isLikedByMe ? "bi-heart-fill text-danger" : "bi-heart";

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">

                    <div style="position: relative;">
                        @if (!string.IsNullOrEmpty(item.MediaUrl) && (item.MediaUrl.EndsWith(".jpg") || item.MediaUrl.EndsWith(".png") || item.MediaUrl.EndsWith(".jpeg")))
                        {
                            <img src="@item.MediaUrl" class="card-img-top rounded-top card-img-custom" alt="@item.Title">
                        }
                        else if (item.MediaUrl != null && item.MediaUrl.Contains("youtube"))
                        {
                            <div class="card-img-top bg-black card-img-placeholder">
                                <i class="bi bi-youtube text-danger fs-1"></i>
                            </div>
                        }
                        else
                        {
                            <div class="card-img-top bg-light card-img-placeholder">
                                <span class="fs-1 text-muted"><i class="bi bi-bookmark-star"></i></span>
                            </div>
                        }

                        <div class="card-overlay-badges">
                            @if (item.Categories != null)
                            {
                                @foreach (var cat in item.Categories)
                                {
                                    <span class="badge bg-light text-dark shadow-sm me-1">
                                        @cat.Name
                                    </span>
                                }
                            }
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title fw-bold text-truncate w-75">@item.Title</h5>

                            @if (currentUserId != null)
                            {
                                <div class="d-flex align-items-center cursor-pointer like-container" onclick="toggleLike(@item.Id)">
                                    <i id="heart-icon-@item.Id" class="bi @heartClass fs-4 me-1 like-icon"></i>
                                    <span id="like-count-@item.Id" class="fw-bold">@item.LikeCount</span>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center">
                                    <a asp-area="Identity" asp-page="/Account/Login" class="text-decoration-none text-dark">
                                        <i class="bi bi-heart fs-4 me-1"></i>
                                        <span class="fw-bold">@item.LikeCount</span>
                                    </a>
                                </div>
                            }
                        </div>

                        <p class="card-subtitle text-muted mb-2 small">
                            <i class="bi bi-person-circle"></i> @(item.User?.UserName ?? "Unknown")
                        </p>

                        <p class="card-text text-truncate">@item.Description</p>
                    </div>

                    <div class="card-footer bg-white border-top-0">
                        <a asp-controller="Bookmarks" asp-action="Show" asp-route-id="@item.Id" class="btn btn-primary w-100 rounded-pill">
                            Vezi Pin-ul
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>