@using dotNet_Project.Models
@using System.Security.Claims
@model PaginatedList<BookmarkCardViewModel>

@{
    ViewData["Title"] = "Home Feed";
    var currentSort = ViewData["CurrentSort"] as string;
    bool isPopular = currentSort == "Popular";
    bool isRecent = string.IsNullOrEmpty(currentSort) || currentSort == "Date";
}

@Html.AntiForgeryToken()

<div class="container mt-4 mb-5">

    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-dark">Discover New Ideas</h1>
        <p class="lead text-muted">Most interesting bookmarks in the community!</p>
    </div>

    <div class="row justify-content-center mb-4">
        <div class="col-md-8">
            <form asp-controller="Home" asp-action="Index" method="get">
                <div class="input-group shadow-sm">
                    <input type="text"
                           name="searchString"
                           class="form-control border-end-0 py-2 ps-4"
                           placeholder="Search by titles, tags, description or categories..."
                           value="@ViewData["CurrentFilter"]"
                           style="border-radius: 50px 0 0 50px; border-color: #ced4da;">

                    @if (ViewData["CurrentFilter"] != null)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary border-start-0 border-end-0 d-flex align-items-center" title="Clear Search" style="border-color: #ced4da;">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }

                    <button class="btn btn-primary px-4 d-flex align-items-center gap-2" type="submit" style="border-radius: 0 50px 50px 0;">
                        <i class="bi bi-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="d-flex justify-content-center gap-2 mb-5">
        <a asp-action="Index"
           asp-route-sortOrder="Date"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn rounded-pill px-4 @(isRecent ? "btn-sort-recent-active" : "btn-sort-recent-outline")">
            <i class="bi bi-clock-history me-1"></i> Most Recent
        </a>

        <a asp-action="Index"
           asp-route-sortOrder="Popular"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn rounded-pill px-4 @(isPopular ? "btn-sort-popular-active" : "btn-sort-popular-outline")">
            <i class="bi bi-fire me-1"></i> Popular
        </a>
    </div>

    <div class="row g-4">
        @if (Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card post-card h-100 shadow-sm border-0">
                        <a asp-controller="Bookmarks" asp-action="Show" asp-route-id="@item.Id" class="card-main-link"></a>

                        <div class="position-relative overflow-hidden" style="height: 250px;">
                            @if (!string.IsNullOrEmpty(item.MediaUrl))
                            {
                                <img src="@item.MediaUrl" class="w-100 h-100 object-fit-cover" alt="@item.Title" loading="lazy" />
                            }
                            else
                            {
                                <div class="w-100 h-100 bg-light d-flex justify-content-center align-items-center">
                                    <i class="bi bi-image text-muted fs-1"></i>
                                </div>
                            }

                            <div class="post-badges-top">
                                @foreach (var catName in item.CategoryNames.Take(2))
                                {
                                    <span class="badge bg-white text-dark shadow-sm opacity-90">@catName</span>
                                }
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-dark text-truncate">@item.Title</h5>
                            <p class="card-text text-muted small text-truncate">
                                @(string.IsNullOrEmpty(item.Description) ? "No description available" : item.Description)
                            </p>

                            <div class="mt-auto d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center bring-to-front" style="z-index: 5;">
                                    <a asp-controller="Profiles" asp-action="Show" asp-route-id="@item.UserName"
                                       class="d-flex align-items-center text-decoration-none text-dark" title="View Profile">
                                        @if (!string.IsNullOrEmpty(item.UserProfilePicture))
                                        {
                                            <img src="@item.UserProfilePicture" class="rounded-circle border" width="30" height="30" style="object-fit:cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center text-white" style="width:30px; height:30px;">
                                                <i class="bi bi-person-fill"></i>
                                            </div>
                                        }
                                        <small class="fw-semibold ms-2">@item.UserDisplayName</small>
                                    </a>
                                </div>

                                <div class="like-container bring-to-front d-flex align-items-center gap-1" onclick="toggleLike(@item.Id)" style="z-index: 5; cursor: pointer;">
                                    <i id="heart-icon-@item.Id"
                                       class="bi @(item.IsLikedByCurrentUser ? "bi-heart-fill text-danger" : "bi-heart text-dark") fs-5 like-icon"></i>
                                    <span id="like-count-@item.Id" class="fw-bold small text-dark">@item.LikeCount</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <div class="text-muted">
                    <i class="bi bi-search fs-1"></i>
                    <p class="mt-3 display-6">No results found.</p>
                    <a asp-action="Index" class="btn btn-outline-primary mt-2">View All</a>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-5">
        @{
            var prevDisabled = !Model.HasPreviousPage ? "disabled" : "";
            var nextDisabled = !Model.HasNextPage ? "disabled" : "";
        }

        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-pageNumber="@(Model.PageIndex - 1)"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-outline-dark me-2 @prevDisabled rounded-pill px-4">
            <i class="bi bi-arrow-left"></i> Previous
        </a>

        <span class="align-self-center mx-3 fw-bold text-muted">
            Page @Model.PageIndex of @Model.TotalPages
        </span>

        <a asp-action="Index"
           asp-route-sortOrder="@ViewData["CurrentSort"]"
           asp-route-pageNumber="@(Model.PageIndex + 1)"
           asp-route-searchString="@ViewData["CurrentFilter"]"
           class="btn btn-outline-dark @nextDisabled rounded-pill px-4">
            Next <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>